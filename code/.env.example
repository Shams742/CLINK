# CLINK environment variables
# Copy to .env and replace the placeholder values. Never commit .env.

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0

# Generate a unique value for local use:
SECRET_KEY=replace-this-with-a-random-secret

# Leave DATABASE_URL unset for local SQLite development.

# For PostgreSQL/Supabase, set DATABASE_URL only in your local .env or hosting provider settings.
